{
  "manifest_version": 3,
  "name": "Arceo browser protection",
  "description": "Apply your offline Arceo focus timers and schedules inside Chrome and Edge.",
  "version": "0.1.1",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
