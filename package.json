{
  "name": "arceo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json src-tauri/tauri.conf.json src-tauri/capabilities/default.json README.md .github/workflows docs scripts",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json src-tauri/tauri.conf.json src-tauri/capabilities/default.json README.md .github/workflows docs scripts",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:engine-offline": "python3 scripts/verify-engine-offline.py",
    "bundle:mac": "tauri build --bundles dmg",
    "bundle:mac:universal": "tauri build --target universal-apple-darwin --bundles dmg",
    "bundle:windows": "tauri build --bundles nsis",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
